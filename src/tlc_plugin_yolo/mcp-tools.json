  {
    "name": "form_from_run",
    "title": "Reuse a YOLO run's settings",
    "description": "Read the native saved form and exact MCP arguments for a run, without starting a job.",
    "input_schema": {
      "type": "object",
      "properties": {
        "run_url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_url"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "route": {
      "method": "GET",
      "path": "/form-from-run",
      "query": [
        "run_url"
      ]
    }
  }
]
